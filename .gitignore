# Spike build artifacts
/spikes/**/build/*.so
/spikes/**/build/*.dylib
/spikes/**/build/*.dll
/spikes/**/*.db
/spikes/**/*.exe
/spikes/**/main
/spikes/**/main_modernc

# Compiled daemon
/bin/

# Coverage output (make cover)
/cover.out

# Athanor runtime state (never committed)
/state/
/state-*/
/backups/
/workspace/
*.db
*.db-wal
*.db-shm

# Local daemon configuration (copy config.example.yaml to start)
/config.yaml

# Probe-specific configs are tracked (config-probe.yaml documents the
# M1-T8 persona mapping); future /config-*.yaml files for other probes
# can be added or ignored explicitly.

# Keep spike source code and docs
!/spikes/**/*.go
!/spikes/**/go.mod
!/spikes/**/go.sum
!/spikes/**/README.md
