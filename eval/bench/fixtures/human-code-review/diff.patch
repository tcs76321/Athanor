@@ -1,4 +1,23 @@
 def load(path):
     with open(path) as f:
         return f.read()
 
+def parse_config(lines):
+    out = {}
+    for line in lines:
+        key, value = line.split("=", 1)
+        out[key.strip()] = value.strip()
+    return out
+
+def first_user(users):
+    return users[0]["name"]
+
+def chunk(items, size):
+    for i in range(0, len(items), size):
+        yield items[i:i + size]
+
+def redact(value):
+    return "*" * len(value)
